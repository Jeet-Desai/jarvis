# Jarvis configuration. Copy to `.env` (`cp .env.example .env`) and fill in
# at least one LLM provider key. Multiple keys = automatic fallback on
# rate-limit / network errors.

# ─── LLM provider 1: Google Gemini (free tier, recommended primary) ────────
# Get a key at: https://aistudio.google.com/apikey  (personal Google account)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# ─── LLM provider 2: OpenAI / OpenAI-compatible (optional fallback) ────────
# Works with OpenAI, OpenRouter, Groq, Together, Mistral, DeepSeek — any
# `/v1/chat/completions` endpoint. Point OPENAI_BASE_URL at the gateway.
#
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
#
# Example: OpenRouter (free Llama/Qwen models):
#   OPENAI_API_KEY=sk-or-v1-...
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENAI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# ─── LLM provider 3: Local Ollama (optional, auto-detected) ────────────────
# If the Ollama daemon is running on localhost:11434, Jarvis auto-includes
# it as a fallback. Uncomment + adjust to override.
#   brew install ollama && ollama pull qwen2.5:7b && ollama serve
#
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen3-coder:480b-cloud   # cloud model, requires ollama account
# # OLLAMA_MODEL=qwen2.5:7b              # local, fully offline

# ─── Optional: explicit provider fallback order ────────────────────────────
# Default if unset: gemini → openai → ollama (any that are configured).
# LLM_PROVIDERS=gemini,ollama,openai

# ─── Optional: TTS voice (macOS `say` voices, see `say -v "?"`) ────────────
# JARVIS_VOICE=Daniel
# JARVIS_VOICE_RATE=195

# ─── Optional: Google Calendar (MCP) ───────────────────────────────────────
# Path to a Google OAuth Desktop-app credentials JSON. When set, Jarvis spawns
# the @cocal/google-calendar-mcp server (via npx) and gains list_calendar_events
# + create_calendar_event tools. See README "Calendar setup" for the one-time
# Google Cloud Console steps.
#
# GOOGLE_OAUTH_CREDENTIALS=/Users/you/.config/jarvis/gcp-oauth.keys.json
